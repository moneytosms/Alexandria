{
  "name": "alexandria",
  "version": "0.1.0",
  "description": "A local-first 3D library for your PDFs",
  "main": "./out/main/index.js",
  "author": {
    "name": "Srimoneyshankar Ajith",
    "email": "moneytosms@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "postinstall": "electron-builder install-app-deps",
    "dist:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource/almendra": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@napi-rs/canvas": "1.1.1",
    "music-metadata": "^11.16.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.180.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  }
}
