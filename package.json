{
  "name": "alexandria",
  "version": "1.0.0",
  "description": "A local-first 3D library for your PDFs",
  "main": "./out/main/index.js",
  "author": {
    "name": "Srimoneyshankar Ajith",
    "email": "moneytosms@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "npm run typecheck && vite build",
    "build:landing": "vite build --config vite.landing.config.ts",
    "build:pages": "node scripts/build-pages.mjs",
    "build:android": "node scripts/build-android.mjs",
    "sync:android": "npm run build:android && npx cap sync android",
    "android:open": "npx cap open android",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "dev:electron": "electron-vite dev",
    "build:electron": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "npm run build:electron && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "dist:dir": "npm run build:electron && electron-builder --dir --publish never",
    "dist:linux": "npm run build:electron && electron-builder --linux --publish never",
    "dist:win": "npm run build:electron && electron-builder --win --publish never",
    "dist:mac": "npm run build:electron && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/almendra": "5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@napi-rs/canvas": "1.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.77.0",
    "music-metadata": "^11.16.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.180.0",
    "tsx": "^4.23.15",
    "vite-plugin-pwa": "^2.0.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  }
}
